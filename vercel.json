{
  "version": 2,
  "builds": [
    {
      "src": "lebarbershop-backend-django/lebarbershop/config/wsgi.py",
      "use": "@vercel/python"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "build" }
    }
  ],
  "routes": [
    {
      "src": "/admin/(.*)",
      "dest": "lebarbershop-backend-django/lebarbershop/config/wsgi.py"
    },
    {
      "src": "/api/(.*)",
      "dest": "lebarbershop-backend-django/lebarbershop/config/wsgi.py"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
