{
  "version": 2,
  "builds": [
    {
      "src": "lebarbershop-backend-django/lebarbershop/config/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.11"
      }
    },
    {
      "src": "lebarbershop-frontend/**",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "lebarbershop-frontend/build"
      }
    }
  ],
  "routes": [
    {
      "src": "/admin/(.*)",
      "dest": "lebarbershop-backend-django/lebarbershop/config/wsgi.py"
    },
    {
      "src": "/api/(.*)",
      "dest": "lebarbershop-backend-django/lebarbershop/config/wsgi.py"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/static/(.*)",
      "dest": "lebarbershop-frontend/build/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "lebarbershop-frontend/build/index.html"
    }
  ],
  "buildCommand": "bash build_files.sh",
  "installCommand": "pip install -r lebarbershop-backend-django/requirements.txt && npm install --prefix lebarbershop-frontend"
}